# ═══════════════════════════════════════════════════════
#  NexusIQ — Environment Variables
#  Copy to .env and fill in your values.
# ═══════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────
ENVIRONMENT=production   # dev | production
DEBUG=false
DEMO_MODE=false          # Set true for VC demos (skips LLM calls)

# ── Database (Neon or Supabase — both FREE) ──────────
# Neon:     https://neon.tech  → New Project → copy connection string
# Supabase: https://supabase.com → Settings → Database → Connection string
DATABASE_URL=postgresql://user:password@host/nexusiq

# ── Redis (Upstash — FREE 10k req/day) ──────────────
# https://upstash.com → Create Database → copy Redis URL
REDIS_URL=rediss://default:password@host:6380

# ── Vector DB (Qdrant Cloud — FREE 1GB) ─────────────
# https://cloud.qdrant.io → Create Cluster → copy URL + API key
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── Storage (Supabase Storage — FREE 1GB) ───────────
# Same Supabase project as DB, or separate.
# Settings → API → copy URL and service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── Auth ────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_real_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ── LLM API Keys ─────────────────────────────────────
# Tier 0: IBM Watsonx (optional, for RAG/course generation)
IBM_BOB_API_KEY=
IBM_BOB_BASE_URL=https://api.ibm.com/watsonx/v1

# Tier 1: Cerebras — 1M tokens/day FREE
# https://cloud.cerebras.ai → Sign up → API Keys
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=

# Tier 2: Gemini — 60 req/min FREE
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Tier 3: Groq — 6k tokens/min FREE (fallback)
# https://console.groq.com → API Keys
GROQ_API_KEY=

# ── Observability (optional) ─────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nexusiq

# ── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
